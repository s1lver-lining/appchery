{
	"name": "Appchery",
	"short_name": "Appchery",
	"description": "Archery Scoring & Tuning",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"orientation": "portrait",
	"background_color": "#f7f3ec",
	"theme_color": "#f3e9d9",
	"icons": [
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-maskable-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"file_handlers": [
		{
			"action": "/import",
			"accept": {
				"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
					".xlsx"
				],
				"application/octet-stream": [
					".xlsx"
				]
			}
		}
	],
	"share_target": {
		"action": "/import",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"files": [
				{
					"name": "file",
					"accept": [
						"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
						".xlsx",
						"application/octet-stream"
					]
				}
			]
		}
	}
}
