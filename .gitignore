node_modules/
.svelte-kit/
build/
# Wrangler bundles the Pages functions through here on every deploy and only tidies up after itself
# when it exits cleanly, so an interrupted deploy leaves its scratch behind.
.wrangler/
drizzle/
*.log
.DS_Store

# Capacitor copies the web build into the native projects; the projects
# themselves are committed, because native config gets hand-edited.
ios/App/App/public/
ios/App/Pods/
ios/App/App/capacitor.config.json
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Copied from node_modules by scripts/sync-sqlite.sh, so it cannot drift from the installed version.
static/sqlite/
TODO.md
# Test imagery: large, and mostly third party datasets. The first three pictures are committed as a
# small fixture; everything else stays local. See doc/camera-scoring.md for where to get them.
test/datasets/
test/pictures/*
!test/pictures/1.png
!test/pictures/2.png
!test/pictures/3.png
!test/pictures/README.md

# The model training environment and its intermediate crops, neither of which the app needs
.venv-ml/
test/datasets/prepared/

# Byte code from the training scripts
__pycache__/

# Per environment Supabase settings, one file per Pages project. .env.example is the template.
.env
.env.*
!.env.example

# The landing page build, the same as build/ but for appchery.com.
build-site/

# Overlay videos the arrow detector writes. Recordings and their replays are large and belong beside
# the datasets, never in a commit.
/*.webm
/*.mp4
/*.mkv
/*.mov
*-overlay.mp4
test/datasets/labelling/
test/datasets/prepared-videos/
