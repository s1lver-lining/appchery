# Copy to .env.preprod and .env.production, one Supabase project each. Both values are public: the
# anon key is meant to be shipped, and Row Level Security is what protects the data. Never put a
# service role key in these files.
#
# Leave them unset and the app builds without sync, which is a working offline app.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
